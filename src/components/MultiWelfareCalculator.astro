<!-- Client scripts for interactivity -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. TABS NAVIGATION CONTROL
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        // Toggle buttons
        tabButtons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        // Toggle panels
        tabPanels.forEach(panel => {
          panel.classList.remove('active');
        });
        document.getElementById(targetId)?.classList.add('active');
      });
    });

    // Segment control logic
    const segmentButtons = document.querySelectorAll('.segment-btn');
    segmentButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const group = btn.getAttribute('data-group');
        segmentButtons.forEach(b => {
          if (b.getAttribute('data-group') === group) {
            b.classList.remove('active');
          }
        });
        btn.classList.add('active');
        calculateWelfare(); // Recalculate everything on change
      });
    });

    // 2. WELFARE CALCULATIONS
    
    // Elements - Pension
    const pWork = document.getElementById('slide-p-work');
    const pOther = document.getElementById('slide-p-other');
    const pProp = document.getElementById('slide-p-prop');
    const pFinance = document.getElementById('slide-p-finance');
    const pDebt = document.getElementById('slide-p-debt');

    const txtPWork = document.getElementById('txt-p-work');
    const txtPOther = document.getElementById('txt-p-other');
    const txtPProp = document.getElementById('txt-p-prop');
    const txtPFinance = document.getElementById('txt-p-finance');
    const txtPDebt = document.getElementById('txt-p-debt');

    const badgePension = document.getElementById('badge-pension');
    const valPTotal = document.getElementById('val-p-total');
    const valPLimit = document.getElementById('val-p-limit');
    const explainPension = document.getElementById('explain-pension');

    // Elements - National
    const nMonths = document.getElementById('slide-n-months');
    const nIncome = document.getElementById('slide-n-income');
    const txtNMonths = document.getElementById('txt-n-months');
    const txtNIncome = document.getElementById('txt-n-income');
    const valNExpected = document.getElementById('val-n-expected');
    const valNRate = document.getElementById('val-n-rate');

    // Elements - Livelihood
    const lIncome = document.getElementById('slide-l-income');
    const txtLIncome = document.getElementById('txt-l-income');
    const lValLiving = document.getElementById('l-val-living');
    const lValMedical = document.getElementById('l-val-medical');
    const lValHousing = document.getElementById('l-val-housing');
    const lItemLiving = document.getElementById('l-item-living');
    const lItemMedical = document.getElementById('l-item-medical');
    const lItemHousing = document.getElementById('l-item-housing');

    // Elements - Medical
    const valMImplant = document.getElementById('val-m-implant');
    const valMDenture = document.getElementById('val-m-denture');
    const descMImplant = document.getElementById('desc-m-implant');
    const descMDenture = document.getElementById('desc-m-denture');

    function calculateWelfare() {
      // --- (1) Pension Calculator logic ---
      if (pWork && pOther && pProp && pFinance && pDebt) {
        const workVal = parseInt(pWork.value);
        const otherVal = parseInt(pOther.value);
        const propVal = parseInt(pProp.value);
        const finVal = parseInt(pFinance.value);
        const debtVal = parseInt(pDebt.value);

        // Update displays
        txtPWork.textContent = workVal.toLocaleString();
        txtPOther.textContent = otherVal.toLocaleString();
        txtPProp.textContent = propVal.toLocaleString();
        txtPFinance.textContent = finVal.toLocaleString();
        txtPDebt.textContent = debtVal.toLocaleString();

        const household = document.querySelector('.segment-btn.active[data-group="p-household"]')?.getAttribute('data-value') || 'single';
        const region = document.querySelector('.segment-btn.active[data-group="p-region"]')?.getAttribute('data-value') || 'large';

        // 2026 Criteria
        const limit = (household === 'single') ? 2190000 : 3504000;
        valPLimit.textContent = limit.toLocaleString() + " 원";

        // 거주지별 기본 공제
        let regionDeduction = 135000000; // 대도시
        if (region === 'medium') regionDeduction = 85000000;
        else if (region === 'small') regionDeduction = 72000000;

        // 근로소득 기본공제 115만원 차감 후 30% 추가 차감
        let netWorkIncome = (workVal * 10000) - 1150000;
        if (netWorkIncome < 0) netWorkIncome = 0;
        netWorkIncome = netWorkIncome * 0.7;

        // 기타소득 (월)
        const netOtherIncome = otherVal * 10000;

        // 일반재산
        let netProperty = (propVal * 10000) - regionDeduction;
        if (netProperty < 0) netProperty = 0;

        // 금융재산 기본공제 2,000만원
        let netFinance = (finVal * 10000) - 20000000;
        if (netFinance < 0) netFinance = 0;

        // 부채 차감
        const totalDebt = debtVal * 10000;

        // 순재산액
        let netWealth = (netProperty + netFinance) - totalDebt;
        if (netWealth < 0) netWealth = 0;

        // 재산 소득 환산액 (연 4% 이율 / 12개월)
        const wealthToIncome = (netWealth * 0.04) / 12;

        // 최종 소득인정액
        const totalIncomeRecognition = Math.round(netWorkIncome + netOtherIncome + wealthToIncome);
        valPTotal.textContent = totalIncomeRecognition.toLocaleString() + " 원";

        if (totalIncomeRecognition <= limit) {
          badgePension.textContent = "수급 가능 유력";
          badgePension.className = "result-badge pass";
          explainPension.textContent = "가구 소득인정액이 2026년 기준 선정기준액보다 낮아 기초연금을 받으실 수 있을 것으로 보입니다. 만 65세 생일 1달 전에 거주지 주민센터에 꼭 방문해 보세요.";
        } else {
          badgePension.textContent = "수급 자격 초과";
          badgePension.className = "result-badge fail";
          explainPension.textContent = "가구 소득인정액이 선정기준액을 일부 초과하여 기초연금 자격에서 제외될 수 있습니다. 금융재산 정리나 공적 채무 증빙 서류를 지참해 상세한 현장 모의 테스트를 받아보시길 권장합니다.";
        }
      }

      // --- (2) National Pension logic ---
      if (nMonths && nIncome) {
        const months = parseInt(nMonths.value);
        const avgIncome = parseInt(nIncome.value);

        txtNMonths.textContent = `${months} 개월 (${Math.floor(months / 12)}년)`;
        txtNIncome.textContent = avgIncome.toLocaleString();

        // 2026년식 간단 노령연금 모의 계산법 (가입 개월수에 비례한 계산)
        // 10년(120개월) 가입 시 평균소득의 약 10~15% 수령 기준
        const rate = 10 + ((months - 120) / 12) * 1.0; // 매년 약 1.0% 누적
        const expected = Math.round((avgIncome * 10000) * (rate / 100));

        valNExpected.textContent = expected.toLocaleString();
        valNRate.textContent = rate.toFixed(1) + "%";
      }

      // --- (3) Livelihood logic ---
      if (lIncome) {
        const members = parseInt(document.querySelector('.segment-btn.active[data-group="l-members"]')?.getAttribute('data-value') || '1');
        const incomeVal = parseInt(lIncome.value);

        txtLIncome.textContent = incomeVal.toLocaleString();

        // 2026년 예상 기준중위소득 (1인: 242만원, 2인: 395만원, 3인: 504만원, 4인: 610만원)
        let medianIncome = 2420000;
        if (members === 2) medianIncome = 3950000;
        else if (members === 3) medianIncome = 5040000;
        else if (members === 4) medianIncome = 6100000;

        const liveLimit = medianIncome * 0.32;
        const medLimit = medianIncome * 0.40;
        const houseLimit = medianIncome * 0.48;

        const myRecognition = incomeVal * 10000;

        // 생계
        if (myRecognition <= liveLimit) {
          lValLiving.textContent = "수급 가능 유력";
          lItemLiving.className = "eligibility-item status-ok";
        } else {
          lValLiving.textContent = "소득 기준 초과";
          lItemLiving.className = "eligibility-item status-no";
        }

        // 의료
        if (myRecognition <= medLimit) {
          lValMedical.textContent = "수급 가능 유력";
          lItemMedical.className = "eligibility-item status-ok";
        } else {
          lValMedical.textContent = "소득 기준 초과";
          lItemMedical.className = "eligibility-item status-no";
        }

        // 주거
        if (myRecognition <= houseLimit) {
          lValHousing.textContent = "수급 가능 유력";
          lItemHousing.className = "eligibility-item status-ok";
        } else {
          lValHousing.textContent = "소득 기준 초과";
          lItemHousing.className = "eligibility-item status-no";
        }
      }

      // --- (4) Medical Discount logic ---
      if (valMImplant && valMDenture) {
        const age = document.querySelector('.segment-btn.active[data-group="m-age"]')?.getAttribute('data-value') || 'over65';
        const welfare = document.querySelector('.segment-btn.active[data-group="m-welfare"]')?.getAttribute('data-value') || 'normal';

        if (age === 'under65') {
          valMImplant.textContent = "혜택 대상 아님";
          valMDenture.textContent = "혜택 대상 아님";
          descMImplant.textContent = "만 65세 생일 이후에 임플란트 건강보험 지원을 받으실 수 있습니다.";
          descMDenture.textContent = "만 65세 생일 이후에 7년 주기로 틀니 보험 혜택이 주어집니다.";
        } else {
          // over 65
          if (welfare === 'normal') {
            valMImplant.textContent = "30%";
            valMDenture.textContent = "30%";
            descMImplant.textContent = "일반 건강보험 대상자는 원래 비용 중 30%만 자부담합니다 (1개당 약 36만원 선).";
            descMDenture.textContent = "틀니 시술 시에도 본인부담 비율은 30%로 감면이 일괄 적용됩니다.";
          } else if (welfare === 'medical-1') {
            valMImplant.textContent = "10%";
            valMDenture.textContent = "5%";
            descMImplant.textContent = "의료급여 1종 어르신은 10%의 초저부담율로 평생 2개까지 임플란트 식립이 가능합니다.";
            descMDenture.textContent = "틀니 본인부담율은 5%로 감면되어 의료 재정이 대폭 부담을 분담합니다.";
          } else if (welfare === 'medical-2' || welfare === 'chasing-manseong') {
            valMImplant.textContent = "20%";
            valMDenture.textContent = "15%";
            descMImplant.textContent = "의료급여 2종 및 희귀난치, 만성질환 차상위 가구 어르신은 본인부담금 20%가 적용됩니다.";
            descMDenture.textContent = "틀니의 본인부담 비율은 15%가 적용되어 매우 경제적입니다.";
          }
        }
      }
    }

    // Attach slider change listeners
    const sliders = document.querySelectorAll('.calc-slider');
    sliders.forEach(slider => {
      slider.addEventListener('input', calculateWelfare);
    });

    // Run initial calculations
    calculateWelfare();
  });
</script>
