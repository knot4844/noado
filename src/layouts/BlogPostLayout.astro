---
import fs from 'fs';
import path from 'path';
import BaseLayout from './BaseLayout.astro';
import MultiWelfareCalculator from '../components/MultiWelfareCalculator.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: string;
    category: string;
    image?: string;
    keywords?: string[];
    updated?: string;
  };
  headings?: {
    depth: number;
    slug: string;
    text: string;
  }[];
  relatedPosts?: any[];
  currentSlug?: string;
  faqs?: { question: string; answer: string; }[];
}

const { frontmatter, headings = [], relatedPosts = [], currentSlug = '', faqs = [] } = Astro.props;

// 애드센스 승인 전에는 광고 슬롯을 렌더링하지 않는다.
// 채워지지 않는 빈 '광고' 상자가 남으면 심사에서 미완성 사이트로 읽힌다.
// 승인 후 PUBLIC_ADS_ENABLED=true 로 켜면 된다.
const adsEnabled = import.meta.env.PUBLIC_ADS_ENABLED === 'true';
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_ID || '';
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const fmtDate = (d: string) =>
  new Date(d).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
const formattedDate = fmtDate(frontmatter.date);

// 글을 실제로 손본 날짜. 없으면 최초 발행일을 쓴다.
const reviewedDate = frontmatter.updated || frontmatter.date;
const lastReviewed = fmtDate(reviewedDate);
const wasRevised = Boolean(frontmatter.updated && frontmatter.updated !== frontmatter.date);

// Check if matching video exists on the filesystem

function getSlug(text) {
  return text
    .toLowerCase()
    .replace(/[^a-z0-9ㄱ-ㅎㅏ-ㅣ가-힣\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
}
const slug = getSlug(frontmatter.title);
const videoPath = `/videos/${slug}.mp4`;
const hasVideo = fs.existsSync(path.join(process.cwd(), 'public', 'videos', `${slug}.mp4`));

// Build the current page URL for sharing
const pageUrl = `https://noado.kr/posts/${currentSlug}`;
const encodedUrl = encodeURIComponent(pageUrl);
const encodedTitle = encodeURIComponent(frontmatter.title);

// JSON-LD Schema for Google Rich Snippets (BlogPosting + FAQ)
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": frontmatter.title,
  "description": frontmatter.description,
  "image": frontmatter.image || "https://noado.kr/logo.png",
  "datePublished": frontmatter.date,
  "dateModified": reviewedDate,
  "url": pageUrl,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": pageUrl
  },
  "author": {
    "@type": "Person",
    "name": "헌신",
    "description": "아버지의 치매·췌장암 간병을 직접 겪은 보호자. 요양보호사 자격 보유(현장 실무 경력 없음).",
    "url": "https://noado.kr/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "노아도 정보광장",
    "url": "https://noado.kr",
    "logo": {
      "@type": "ImageObject",
      "url": "https://noado.kr/logo.png"
    }
  },
  "keywords": frontmatter.keywords?.join(', ') || frontmatter.category
};

// BreadcrumbList Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "홈",
      "item": "https://noado.kr"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": frontmatter.category,
      "item": `https://noado.kr/category/${encodeURIComponent(frontmatter.category)}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": frontmatter.title,
      "item": pageUrl
    }
  ]
};

// FAQ Schema
const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer.replace(/<[^>]*>/g, '').replace(/\*\*|__/g, '') // remove HTML tags and markdown bold inside JSON-LD
    }
  }))
} : null;
---

<BaseLayout 
  title={frontmatter.title} 
  description={frontmatter.description} 
  image={frontmatter.image}
  articleDate={frontmatter.date}
>
  <!-- Inject Article Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <!-- Inject Breadcrumb Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <!-- Inject FAQ Schema if available -->
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <article class="blog-post">
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="/">홈</a>
      <span class="breadcrumb-sep">›</span>
      <a href={`/category/${encodeURIComponent(frontmatter.category)}`} class="breadcrumb-category">{frontmatter.category}</a>
      <span class="breadcrumb-sep">›</span>
      <span class="breadcrumb-current">{frontmatter.title.length > 30 ? frontmatter.title.substring(0, 30) + '…' : frontmatter.title}</span>
    </nav>

    <!-- Meta details -->
    <div class="post-meta">
      <span class="post-category">{frontmatter.category}</span>
      <time datetime={frontmatter.date}>{formattedDate}</time>
      {wasRevised && <span class="post-updated">· {lastReviewed} 수정</span>}
    </div>

    <!-- Title -->
    <h1 class="post-title">{frontmatter.title}</h1>

    <!-- Featured Image -->
    <div class="post-featured-image">
      <img src={frontmatter.image || "/default-og.png"} alt={frontmatter.title} class="featured-img" loading="eager" />
    </div>

    <!-- AdSense Top Banner (승인 후 활성화) -->
    {adsEnabled && (
      <div class="adsense-container header-ad">
        <div class="adsense-label">광고</div>
        <ins class="adsbygoogle"
             style="display:block"
             data-ad-client={adsenseClient}
             data-ad-format="auto"
             data-full-width-responsive="true"></ins>
        <script>
             (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
      </div>
    )}

    <!-- Content Body -->
    {hasVideo && (
      <div class="post-video-section">
        <div class="video-preview-header">
          <span class="video-badge">15초 요약</span>
          <h3>🎬 이 글의 15초 영상 요약</h3>
        </div>
        <div class="video-container">
          <video src={videoPath} controls autoplay muted loop playsinline class="promo-video-player"></video>
        </div>
      </div>
    )}

    <!-- Table of Contents (TOC) -->
    {filteredHeadings.length > 0 && (
      <div class="toc-container">
        <div class="toc-header">
          <span class="toc-icon">📋</span>
          <span class="toc-title">목차</span>
        </div>
        <ul class="toc-list">
          {filteredHeadings.map((h) => (
            <li class={`toc-item depth-${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="post-content">
      <slot />
    </div>

    {
      (frontmatter.category === '기초·국민연금' || 
       frontmatter.category === '건강·의료' || 
       frontmatter.category === '생활 지원금' || 
       frontmatter.category === '복지·주거' || 
       frontmatter.category === '생활·돌봄' ||
       frontmatter.title.includes('수급자') ||
       frontmatter.title.includes('연금') ||
       frontmatter.title.includes('지원금') ||
       frontmatter.title.includes('임플란트') ||
       frontmatter.title.includes('틀니')) && (
        <MultiWelfareCalculator />
      )
    }

    <!-- Social Share Buttons (카카오톡, 네이버 밴드, 페이스북, 링크 복사) -->
    <div class="share-section">
      <h3 class="share-title">📤 이 글이 도움이 되셨나요? 주변 분들에게 공유해 주세요!</h3>
      <div class="share-buttons">
        <!-- 카카오톡 -->
        <a href={`https://story.kakao.com/share?url=${encodedUrl}`} target="_blank" rel="noopener noreferrer" class="share-btn kakao" title="카카오스토리 공유">
          <span class="share-icon">💬</span>
          <span class="share-label">카카오</span>
        </a>
        <!-- 네이버 밴드 -->
        <a href={`https://band.us/plugin/share?body=${encodedTitle}%20${encodedUrl}&route=${encodedUrl}`} target="_blank" rel="noopener noreferrer" class="share-btn band" title="네이버 밴드 공유">
          <span class="share-icon">🟢</span>
          <span class="share-label">밴드</span>
        </a>
        <!-- 네이버 블로그 -->
        <a href={`https://share.naver.com/web/shareView?url=${encodedUrl}&title=${encodedTitle}`} target="_blank" rel="noopener noreferrer" class="share-btn naver" title="네이버 블로그 공유">
          <span class="share-icon">📗</span>
          <span class="share-label">네이버</span>
        </a>
        <!-- 페이스북 -->
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} target="_blank" rel="noopener noreferrer" class="share-btn facebook" title="페이스북 공유">
          <span class="share-icon">📘</span>
          <span class="share-label">페이스북</span>
        </a>
        <!-- 링크 복사 -->
        <button class="share-btn copy-link" id="copy-link-btn" data-url={pageUrl} title="링크 복사">
          <span class="share-icon">🔗</span>
          <span class="share-label">링크복사</span>
        </button>
      </div>
    </div>

    <!-- AdSense Bottom Banner (승인 후 활성화) -->
    {adsEnabled && (
      <div class="adsense-container footer-ad">
        <div class="adsense-label">광고</div>
        <ins class="adsbygoogle"
             style="display:block"
             data-ad-format="autorelaxed"
             data-ad-client={adsenseClient}></ins>
        <script>
             (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
      </div>
    )}

    <!-- Keywords / Tags -->
    {frontmatter.keywords && frontmatter.keywords.length > 0 && (
      <div class="post-tags">
        {frontmatter.keywords.map((kw) => (
          <span class="tag">#{kw}</span>
        ))}
      </div>
    )}

    <!-- Related Posts (Internal Links) -->
    {relatedPosts.length > 0 && (
      <section class="related-posts">
        <h2 class="related-title">📰 함께 읽으면 좋은 글</h2>
        <div class="related-grid">
          {relatedPosts.map(post => (
            <a href={`/posts/${post.slug}`} class="related-card">
              <span class="related-category">{post.data.category}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description.substring(0, 80)}…</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- E-E-A-T Author Card -->
    <section class="post-author-section">
      <div class="author-card-header">
        <div class="author-avatar-badge">
          <span class="author-avatar-emoji">🕊️</span>
        </div>
        <div class="author-header-info">
          <span class="author-lbl">아버지를 간병한 보호자 · 요양보호사 자격 보유</span>
          <h4 class="author-name">헌신</h4>
        </div>
      </div>
      <p class="author-desc">
        아버지께서 치매 진단을 받으시고, 이후 췌장암 4기로 2023년에 돌아가시기까지 곁에서 간병했습니다.
        장기요양 등급을 신청하고, 병원비와 돌봄 비용을 감당할 방법을 찾아 제도를 뒤지던 시간 동안
        가장 아쉬웠던 것은 <strong>제도가 없다는 사실이 아니라, 있는 제도를 제때 몰랐다는 사실</strong>이었습니다.
        그때 제가 찾아 헤맸던 정보를 지금 같은 처지에 계신 분들이 덜 헤매고 찾으실 수 있도록 정리합니다.
      </p>
      <p class="author-disclosure">
        10여 년 전 요양보호사 자격을 취득했으나 <strong>현장 실무 경력은 없습니다.</strong>
        따라서 이 글은 전문가의 상담이 아니라, 같은 일을 먼저 겪은 보호자가 공식 자료를 확인해 정리한 안내입니다.
        모든 수치와 자격 요건은 보건복지부·국민연금공단 등 공식 발표 자료를 근거로 하며,
        최종 판정은 반드시 관할 기관에서 확인하셔야 합니다.
      </p>
      <div class="author-meta-info">
        <span class="author-meta-item">📅 최종 검수일: {lastReviewed}</span>
        <span class="author-meta-item">📧 정정 제보 및 문의: <a href="mailto:knot4844@gmail.com">knot4844@gmail.com</a></span>
      </div>
    </section>

    <!-- Warning / Disclaimers -->
    <div class="post-disclaimer">
      <p><strong>안내사항:</strong> 본 블로그에서 제공하는 정보는 공식 기관의 발표 자료 및 보도자료를 참고하여 작성되었습니다. 정부 정책 및 지원 조건은 수시로 변경될 수 있으므로, 최종 신청 전에 반드시 관계 기관의 공식 홈페이지 또는 콜센터를 통해 정확한 요건을 재확인하시기 바랍니다.</p>
    </div>
  <!-- 본문 중간 광고 동적 삽입 (승인 후 PUBLIC_ADS_ENABLED=true 로 활성화) -->
    <script define:vars={{ adsEnabled, adsenseClient }}>
      if (adsEnabled && adsenseClient) {
        document.addEventListener('DOMContentLoaded', () => {
          const postContent = document.querySelector('.post-content');
          if (postContent) {
            const paragraphs = postContent.querySelectorAll('p, h2, h3, table');
            if (paragraphs.length >= 6) {
              // 두 번째 및 네 번째 주요 단락 뒤에 본문 인피드 광고 생성 주입
              const insertAd = (targetIndex) => {
                const adContainer = document.createElement('div');
                adContainer.className = 'adsense-container body-ad';
                adContainer.innerHTML = `
                  <div class="adsense-label">광고</div>
                  <ins class="adsbygoogle"
                       style="display:block; text-align:center;"
                       data-ad-layout="in-article"
                       data-ad-format="fluid"
                       data-ad-client="${adsenseClient}"></ins>
                `;
                paragraphs[targetIndex].parentNode.insertBefore(adContainer, paragraphs[targetIndex].nextSibling);
                try {
                  (adsbygoogle = window.adsbygoogle || []).push({});
                } catch(e) {}
              };

              if (paragraphs.length > 3) insertAd(2);
              if (paragraphs.length > 7) insertAd(6);
            }
          }
        });
      }
    </script>
  </article>
</BaseLayout>

<!-- Copy link script -->
<script>
  const copyBtn = document.getElementById('copy-link-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const url = copyBtn.getAttribute('data-url') || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        const label = copyBtn.querySelector('.share-label');
        if (label) {
          const original = label.textContent;
          label.textContent = '복사완료!';
          setTimeout(() => { label.textContent = original; }, 2000);
        }
      } catch {
        // Fallback for older browsers
        const input = document.createElement('input');
        input.value = url;
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        document.body.removeChild(input);
      }
    });
  }
</script>

<style>
  .post-featured-image {
    width: 100%;
    margin-bottom: 2rem;
    border-radius: var(--radius);
    overflow: hidden;
    border: 2px solid var(--border-color);
    box-shadow: var(--card-shadow);
  }

  .featured-img {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
    display: block;
    transition: var(--transition-smooth);
  }

  .featured-img:hover {
    transform: scale(1.01);
  }

  .blog-post {
    max-width: 800px;
    margin: 0 auto;
    background-color: var(--bg-secondary);
    border: 2px solid var(--border-color);
    border-radius: var(--radius);
    padding: 2rem 1.5rem;
    box-shadow: var(--card-shadow);
  }

  @media (min-width: 768px) {
    .blog-post {
      padding: 3rem;
    }
  }

  /* Breadcrumb */
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .breadcrumb a {
    color: var(--text-secondary);
    transition: color 0.2s;
  }

  .breadcrumb a:hover { color: var(--accent); }

  .breadcrumb-sep { color: var(--text-muted); }

  .breadcrumb-category {
    color: var(--accent);
    font-weight: 600;
  }

  .breadcrumb-current {
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 250px;
  }

  .post-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .post-updated {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .post-category {
    background-color: var(--accent-glow);
    color: #60a5fa;
    padding: 0.2rem 0.75rem;
    border-radius: 50px;
    font-weight: 600;
  }

  :root.light-mode .post-category {
    color: var(--accent);
  }

  .post-title {
    font-size: 2rem;
    line-height: 1.35;
    font-weight: 700;
    margin-bottom: 2rem;
    word-break: keep-all;
  }

  @media (min-width: 768px) {
    .post-title {
      font-size: 2.5rem;
    }
  }

  /* Markdown content styling */
  .post-content :global(p) {
    font-size: 1.25rem;
    line-height: 1.8;
    color: var(--text-primary);
    margin-bottom: 1.75rem;
    word-break: keep-all;
  }

  .post-content :global(h2) {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 2.8rem 0 1.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--border-color);
    color: var(--text-primary);
  }

  .post-content :global(h3) {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 2.2rem 0 1.2rem;
    color: var(--text-primary);
  }

  .post-content :global(ul), .post-content :global(ol) {
    margin: 0 0 1.75rem 1.75rem;
    font-size: 1.2rem;
    line-height: 1.8;
  }

  .post-content :global(li) {
    margin-bottom: 0.6rem;
  }

  .post-content :global(strong) {
    font-weight: 800;
    color: var(--accent);
  }

  :root.dark-mode .post-content :global(strong) {
    color: #FFB380;
  }

  /* Table styling */
  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2.2rem 0;
    font-size: 1.1rem;
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .post-content :global(th), .post-content :global(td) {
    border: 1px solid var(--border-color);
    padding: 0.75rem 1rem;
    text-align: left;
  }

  .post-content :global(th) {
    background-color: var(--bg-tertiary);
    font-weight: 600;
  }

  /* Blockquote */
  .post-content :global(blockquote) {
    border-left: 4px solid var(--accent);
    background-color: var(--bg-tertiary);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .post-content :global(blockquote p) {
    margin-bottom: 0;
    font-style: italic;
    color: var(--text-secondary);
  }

  /* TOC Styling */
  .toc-container {
    background: rgba(30, 41, 59, 0.4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin: 2rem 0;
  }

  :root.light-mode .toc-container {
    background: rgba(248, 250, 252, 0.85);
  }

  .toc-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed var(--border-color);
  }

  .toc-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .toc-icon { font-size: 1.25rem; }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item { margin-bottom: 0.5rem; line-height: 1.5; }

