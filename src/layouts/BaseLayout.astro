---
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  image?: string;
  articleDate?: string;
}

const { 
  title, 
  description = "부모님을 간병하며 직접 찾아 헤맸던 노인 복지 제도를 정리합니다. 기초연금·장기요양·의료비 지원의 자격 요건과 신청 방법을 보호자의 눈높이로 안내합니다.", 
  image = "/default-og.png",
  articleDate
} = Astro.props;

// 푸터 카테고리는 실제 글 데이터에서 뽑는다.
// (직접 적어두었던 5개 중 3개가 존재하지 않는 이름이라 빈 목록으로 이어지고 있었다)
const footerCategories = [...new Set((await getCollection('posts')).map((p) => p.data.category))].sort();

// AdSense Publisher ID - Loaded from env or fallback placeholder
const adsenseId = import.meta.env.PUBLIC_ADSENSE_ID || "ca-pub-XXXXXXXXXXXXX";
const formattedAdsenseId = adsenseId.startsWith("pub-") ? `ca-${adsenseId}` : adsenseId;

// Search Console Verification Keys
const naverVerification = import.meta.env.PUBLIC_NAVER_VERIFICATION || "";
const googleVerification = import.meta.env.PUBLIC_GOOGLE_VERIFICATION || "";
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    {naverVerification && <meta name="naver-site-verification" content={naverVerification} />}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    
    <!-- SEO Meta Tags -->
    <title>{title} | 노아도 알짜정책 포털</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
    
    <!-- Open Graph (Facebook/KakaoTalk) -->
    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    {articleDate && <meta property="article:published_time" content={articleDate} />}

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Noto+Sans+KR:wght@300;400;500;700&display=swap" rel="stylesheet">

    <!-- Google AdSense Integration -->
    {formattedAdsenseId && formattedAdsenseId !== "ca-pub-XXXXXXXXXXXXX" && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${formattedAdsenseId}`} crossorigin="anonymous"></script>
    )}

    <!-- Global CSS Styles -->
    <style is:global>
      :root {
        --font-primary: 'Noto Sans KR', sans-serif;
        --font-display: 'Outfit', sans-serif;
        
        /* 웜 미니멀리즘 (기본값: 라이트 모드) */
        --bg-primary: #FDFCF9;          /* 따뜻한 미색 종이 질감 배경 */
        --bg-secondary: #FFFFFF;        /* 완전 백색 카드 */
        --bg-tertiary: #F5F2EB;         /* 옅은 모래색 구분 영역 */
        
        --text-primary: #2B2B2B;        /* 눈부심 없는 진한 차콜 폰트 */
        --text-secondary: #5A5650;      /* 가독성 서브 색상 */
        --text-muted: #8A857D;
        
        --accent: #FF8C42;              /* 시그니처 주황색 */
        --accent-glow: rgba(255, 140, 66, 0.15);
        --accent-gradient: linear-gradient(135deg, #FF8C42 0%, #E06A1F 100%);
        --accent-success: #2E8B57;
        --accent-warning: #F5A623;
        
        --border-color: #E2DDD5;        /* 명확하고 연한 웜 그레이 윤곽선 */
        --card-shadow: 0 4px 12px rgba(0, 0, 0, 0.02);
        --transition-smooth: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        --radius: 16px;
      }

      /* 어두운 모드 (시니어 야간 눈 보호) */
      :root.dark-mode {
        --bg-primary: #1C1C1E;          /* 부드러운 차콜 다크 배경 */
        --bg-secondary: #2C2C2E;        /* 어두운 회색 카드 */
        --bg-tertiary: #3A3A3C;
        
        --text-primary: #E5E5EA;        /* 밝은 회색 글자 (고대비) */
        --text-secondary: #AEAEB2;
        --text-muted: #8E8E93;
        
        --accent: #FF8C42;
        --accent-glow: rgba(255, 140, 66, 0.3);
        --accent-gradient: linear-gradient(135deg, #FF8C42 0%, #FFB380 100%);
        
        --border-color: #38383A;
        --card-shadow: 0 4px 12px rgba(0, 0, 0, 0.3);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--bg-primary);
        color: var(--text-primary);
        font-family: var(--font-primary);
        line-height: 1.6;
        transition: var(--transition-smooth);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      a {
        color: var(--accent);
        text-decoration: none;
        transition: var(--transition-smooth);
      }

      a:hover {
        opacity: 0.9;
      }

      /* Header Layout */
      header {
        background-color: rgba(253, 252, 249, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border-color);
        position: sticky;
        top: 0;
        z-index: 100;
        transition: var(--transition-smooth);
      }
 
      :root.dark-mode header {
        background-color: rgba(28, 28, 30, 0.85);
        border-bottom: 1px solid var(--border-color);
      }

      .header-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo-container {
        display: flex;
        align-items: center;
        height: 48px;
        transition: var(--transition-smooth);
      }

      .logo-container:hover {
        transform: scale(1.02);
      }

      .header-logo {
        height: 100%;
        width: auto;
        object-fit: contain;
        filter: drop-shadow(0 0 6px rgba(37, 99, 235, 0.35));
      }

      .nav-links {
        display: flex;
        gap: 1.5rem;
        align-items: center;
      }

      .nav-links a {
        color: var(--text-secondary);
        font-weight: 500;
        font-size: 0.95rem;
      }

      .nav-links a:hover, .nav-links a.active {
        color: var(--text-primary);
      }

      /* Dark/Light mode Toggle */
      .theme-toggle-btn {
        background: var(--bg-tertiary);
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        width: 38px;
        height: 38px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--transition-smooth);
      }

      .theme-toggle-btn:hover {
        transform: scale(1.05);
        border-color: var(--accent);
      }

      /* Main container */
      main {
        flex: 1;
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
        padding: 2.5rem 1.5rem;
      }

      /* Footer Layout */
      footer {
        background-color: var(--bg-secondary);
        border-top: 1px solid var(--border-color);
        padding: 3rem 1.5rem;
        margin-top: auto;
      }

      .footer-container {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      @media (min-width: 768px) {
        .footer-container {
          grid-template-columns: 2fr 1fr 1fr;
        }
      }

      .footer-about h3 {
        font-family: var(--font-display);
        font-size: 1.3rem;
        margin-bottom: 1rem;
        color: var(--text-primary);
      }

      .footer-about p {
        color: var(--text-secondary);
        font-size: 0.9rem;
        max-width: 400px;
      }

      .footer-links h4 {
        font-size: 1rem;
        margin-bottom: 1rem;
        color: var(--text-primary);
      }

      .footer-links ul {
        list-style: none;
      }

      .footer-links li {
        margin-bottom: 0.6rem;
      }

      .footer-links a {
        color: var(--text-secondary);
        font-size: 0.9rem;
      }

      .footer-links a:hover {
        color: var(--text-primary);
        padding-left: 4px;
      }

      .footer-bottom {
        max-width: 1200px;
        margin: 2rem auto 0;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        font-size: 0.85rem;
        color: var(--text-muted);
      }

      @media (min-width: 768px) {
        .footer-bottom {
          flex-direction: row;
        }
      }

      /* Premium AdSense Container Styles */
      .adsense-container {
        width: 100%;
        margin: 2rem 0;
        padding: 1rem;
        background-color: var(--bg-secondary);
        border: 1px dashed var(--border-color);
        border-radius: var(--radius);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100px;
        position: relative;
        overflow: hidden;
      }

      .adsense-label {
        font-size: 0.75rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 0.5rem;
      }

      /* 공식 안내처 링크 — 광고로 오인되지 않도록 정적인 텍스트 링크로 유지한다.
         (애니메이션·광고 유사 배치는 애드센스 정책 위반 소지가 있어 제거함) */
      .ctr-btn-container {
        margin: 2rem 0;
        display: flex;
        justify-content: flex-start;
      }

      .ctr-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        color: var(--accent) !important;
        font-weight: 600;
        font-size: 1.05rem;
        padding: 0.75rem 1.25rem;
        border: 1px solid var(--accent);
        border-radius: var(--radius);
        transition: var(--transition-smooth);
      }

      .ctr-button:hover {
        background: var(--accent);
        color: #ffffff !important;
      }

      /* 본문 하단 연관 글 네비게이션 — 라이트/다크 모두에서 읽히도록 테마 토큰만 사용한다 */
      .series-nav-container {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        padding: 1.5rem;
        margin: 2.5rem 0;
      }

      .series-nav-container h4 {
        margin: 0 0 1rem;
        padding-left: 0.75rem;
        border-left: 4px solid var(--accent);
        font-size: 1.15rem;
        color: var(--text-primary);
      }

      .series-nav-container ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .series-nav-container li + li {
        margin-top: 0.6rem;
      }

      .series-nav-container li a {
        display: block;
        padding: 0.7rem 0.9rem;
        background: var(--bg-tertiary);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        color: var(--text-primary);
        font-size: 0.95rem;
        font-weight: 500;
      }

      .series-nav-container li a:hover {
        border-color: var(--accent);
        color: var(--accent);
      }
    </style>

    <!-- Theme manager script to prevent flash of light/dark mode -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: light)').matches) {
          return 'light';
        }
        return 'dark';
      })();
      
      if (theme === 'light') {
        document.documentElement.classList.add('light-mode');
      } else {
        document.documentElement.classList.remove('light-mode');
      }
    </script>
  </head>
  <body>
    <header>
      <div class="header-container">
        <a href="/" class="logo-container" id="logo-link">
          <img src="/logo.png" alt="NOADO 노아도" class="header-logo" />
        </a>
        <nav class="nav-links">
          <a href="/" id="nav-home">홈</a>
          <a href="/about" id="nav-about">소개</a>
          <a href="/contact" id="nav-contact">문의</a>
          <button class="theme-toggle-btn" id="theme-toggle" aria-label="Toggle theme">
            <!-- Sun Icon -->
            <svg id="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
            <!-- Moon Icon -->
            <svg id="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-container">
        <div class="footer-about">
          <h3>노아도 정보광장</h3>
          <p>아버지를 간병하며 찾아 헤맸던 노인 복지 제도를, 같은 처지에 계신 분들이 덜 헤매시도록 정리해 두는 곳입니다.</p>
        </div>
        <div class="footer-links">
          <h4>카테고리</h4>
          <ul>
            {footerCategories.map((cat) => (
              <li><a href={`/category/${encodeURIComponent(cat)}`}>{cat}</a></li>
            ))}
          </ul>
        </div>
        <div class="footer-links">
          <h4>정보 및 정책</h4>
          <ul>
            <li><a href="/about" id="footer-about">사이트 소개</a></li>
            <li><a href="/contact" id="footer-contact">문의하기</a></li>
            <li><a href="/privacy" id="footer-privacy">개인정보처리방침</a></li>
            <li><a href="/terms" id="footer-terms">이용약관</a></li>
            <li><a href="/sitemap-index.xml" target="_blank" id="footer-sitemap">사이트맵</a></li>
            <li><a href="/rss.xml" target="_blank" id="footer-rss">RSS 피드</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} 노아도 정보광장. All rights reserved.</p>
        <p>본 사이트의 정보는 참고용이며, 정확한 내용은 공식 안내처를 통해 확인하시기 바랍니다.</p>
      </div>
    </footer>

    <!-- Theme toggle click handling script -->
    <script>
      const toggle = document.getElementById('theme-toggle');
      const sunIcon = document.getElementById('sun-icon');
      const moonIcon = document.getElementById('moon-icon');
      
      function updateIcons() {
        const isDark = document.documentElement.classList.contains('dark-mode');
        if (isDark) {
          sunIcon.style.display = 'block';
          moonIcon.style.display = 'none';
        } else {
          sunIcon.style.display = 'none';
          moonIcon.style.display = 'block';
        }
      }

      // Initial theme loading
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark') {
        document.documentElement.classList.add('dark-mode');
      } else {
        document.documentElement.classList.remove('dark-mode');
      }

      // Initial icon state
      updateIcons();

      toggle?.addEventListener('click', () => {
        const element = document.documentElement;
        element.classList.toggle('dark-mode');
        
        const isDark = element.classList.contains('dark-mode');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateIcons();
      });
    </script>
  </body>
</html>
